{% extends 'base.html.twig' %}

{% block title %}Contact Us - SKADOOSH{% endblock %}

{% block body %}
<section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
  <header class="text-center pt-8 pb-12 max-w-2xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] mb-3" style="color:#7a0000;">Contact</p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight" style="color:#7a0000;">We’d love to hear from you</h1>
    <p class="mt-5 text-lg leading-relaxed" style="color:#4b5563;">
      Orders, sizing, or collaborations—send a message and we’ll get back to you.
    </p>
  </header>

  {% for msg in app.flashes('error') %}
    <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium" style="color:#7a0000;">
      {{ msg }}
    </p>
  {% endfor %}

  {% if app.request.query.get('sent') == '1' %}
    <p class="mb-10 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium" style="color:#065f46;">
      Thanks! Your message was sent. If you don’t hear back within 24–48 hours, email us directly below.
    </p>
  {% endif %}

  <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 border-t border-red-100 pt-12">
    <form
      action="{{ path('app_page_contact') }}"
      method="POST"
      class="lg:col-span-7 space-y-5"
    >
      <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">

      <h2 class="text-lg font-bold" style="color:#111827;">Send a message</h2>
      <p class="text-sm leading-relaxed -mt-2" style="color:#6b7280;">
        Sent via Brevo (SMTP) using Symfony Mailer.
      </p>

      <label class="block text-sm font-semibold" for="name">Full name</label>
      <input id="name" name="name" type="text" required class="w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="Your name">

      <label class="block text-sm font-semibold" for="email">Email</label>
      <input id="email" name="email" type="email" required class="w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="you@example.com">

      <label class="block text-sm font-semibold" for="topic">Topic</label>
      <select id="topic" name="topic" class="w-full rounded-lg border border-gray-200 px-4 py-3 bg-white">
        <option>Order concern</option>
        <option>Product / sizing</option>
        <option>Account / login</option>
        <option>Partnership</option>
        <option>Other</option>
      </select>

      <label class="block text-sm font-semibold" for="message">Message</label>
      <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="Your message…"></textarea>

      <button type="submit" class="btn-primary">Submit</button>
    </form>

    <aside class="lg:col-span-5 space-y-10 text-sm" style="color:#374151;">
      <address class="not-italic leading-relaxed space-y-6 border-l-2 pl-5" style="border-color: rgba(122,0,0,0.2);">
        <p>
          <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#7a0000;">Email</span>
          <a href="mailto:support@skadoosh.com" class="hover:underline" style="color:#111827;">support@skadoosh.com</a>
        </p>
        <p>
          <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#7a0000;">Phone</span>
          <a href="tel:+15551234567" class="hover:underline" style="color:#111827;">+1 (555) 123-4567</a>
        </p>
        <p>
          <span class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#7a0000;">Address</span>
          123 Fashion St, Style City, SC 12345
        </p>
      </address>

      <section>
        <h2 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color:#7a0000;">Hours</h2>
        <dl class="space-y-2">
          <div class="flex justify-between gap-4"><dt>Mon–Fri</dt><dd class="font-medium m-0">9:00 AM – 6:00 PM</dd></div>
          <div class="flex justify-between gap-4"><dt>Saturday</dt><dd class="font-medium m-0">10:00 AM – 4:00 PM</dd></div>
          <div class="flex justify-between gap-4"><dt>Sunday</dt><dd class="font-medium m-0">Closed</dd></div>
        </dl>
      </section>

      <p class="text-xs pt-4 border-t border-gray-100" style="color:#9ca3af;">
        <a href="{{ path('app_page') }}" class="font-medium hover:underline" style="color:#7a0000;">Home</a>
        ·
        <a href="{{ path('app_page_about') }}" class="font-medium hover:underline" style="color:#7a0000;">About</a>
      </p>
    </aside>
  </section>
</section>
{% endblock %}
