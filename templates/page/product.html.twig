{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - SKADOOSH{% endblock %}

{% block stylesheets %}
<style>
  body {
    background-image: url('{{ asset('Pattern.png') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  .pd-surface {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(148, 163, 184, 0.35);
  }
  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 1px solid rgba(148,163,184,0.6);
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.85);
  }
  .swatch[aria-checked="true"] {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }
  .size-btn[aria-pressed="true"] {
    border-color: #111827 !important;
    background: #111827 !important;
    color: #ffffff !important;
  }
</style>
{% endblock %}

{% block body %}
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
  <nav class="text-xs sm:text-sm mb-6" style="color:#64748b;">
    <a href="{{ path('app_shop') }}" class="underline" style="color:#7a0000;">Shop</a>
    <span aria-hidden="true"> / </span>
    <span style="color:#0f172a;">{{ product.name }}</span>
  </nav>

  <div class="pd-surface rounded-2xl p-4 sm:p-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <div class="col-span-2 sm:col-span-1 rounded-xl overflow-hidden bg-white border border-slate-200/60">
            {% if product.image %}
              <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" class="w-full h-full object-cover">
            {% else %}
              <div class="aspect-[4/5] flex items-center justify-center text-sm" style="color:#64748b;">No image</div>
            {% endif %}
          </div>
          <div class="col-span-2 sm:col-span-1 rounded-xl overflow-hidden bg-white border border-slate-200/60">
            {% if product.image %}
              <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }} alternate" class="w-full h-full object-cover opacity-95">
            {% else %}
              <div class="aspect-[4/5] flex items-center justify-center text-sm" style="color:#64748b;">No image</div>
            {% endif %}
          </div>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <h1 class="text-2xl sm:text-3xl font-extrabold leading-tight" style="color:#0f172a;">{{ product.name }}</h1>
        <p class="mt-2 text-xs uppercase tracking-wider" style="color:#64748b;">
          {{ product.category ? product.category.name : 'Uncategorized' }}
        </p>

        <p class="mt-4 text-lg font-extrabold" style="color:#7a0000;">₱{{ product.price|number_format(2, '.', ',') }}</p>
        <p class="mt-1 text-xs" style="color:#64748b;">In stock</p>

        <div class="mt-6 border-t border-slate-200/60 pt-6">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-sm font-extrabold" style="color:#0f172a;">Color</h2>
            {% set selectedColor = (colors|filter(c => c.code == colorCode)|first) %}
            <p class="text-xs" style="color:#64748b;">{{ selectedColor ? selectedColor.name : colorCode }}</p>
          </div>

          <div class="mt-3 flex flex-wrap gap-3" role="radiogroup" aria-label="Select color">
            {% for c in colors %}
              <a
                href="{{ path('app_shop_product', {'id': product.id}) ~ '?colorCode=' ~ c.code ~ '&sizeCode=' ~ sizeCode }}"
                class="swatch"
                style="background: {{ c.hex }};"
                role="radio"
                aria-checked="{{ c.code == colorCode ? 'true' : 'false' }}"
                aria-label="{{ c.name }}"
                title="{{ c.name }}"
              ></a>
            {% endfor %}
          </div>
        </div>

        {% set isAccessories = product.category and (product.category.name|lower == 'accessories') %}
        {% if not isAccessories %}
          <div class="mt-6 border-t border-slate-200/60 pt-6">
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-sm font-extrabold" style="color:#0f172a;">Size</h2>
              {% set selectedSize = (sizes|filter(s => s.code == sizeCode)|first) %}
              <p class="text-xs" style="color:#64748b;">{{ selectedSize ? selectedSize.label : sizeCode }}</p>
            </div>

            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Select size">
              {% for s in sizes %}
                <a
                  href="{{ path('app_shop_product', {'id': product.id}) ~ '?colorCode=' ~ colorCode ~ '&sizeCode=' ~ s.code }}"
                  class="size-btn inline-flex items-center justify-center w-11 h-11 rounded-lg border border-slate-300 bg-white text-sm font-extrabold"
                  style="color:#0f172a; text-decoration:none;"
                  aria-pressed="{{ s.code == sizeCode ? 'true' : 'false' }}"
                >{{ s.label }}</a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="mt-7">
          <button type="button" class="w-full rounded-xl py-3.5 font-extrabold" style="background:#111827; color:#ffffff;">
            Add to cart
          </button>
          <p class="mt-3 text-xs leading-relaxed" style="color:#64748b;">
            This is a UI demo like the Uniqlo layout: options update the URL (colorCode/sizeCode). Cart logic can be added next.
          </p>
        </div>

        <div class="mt-8 border-t border-slate-200/60 pt-6">
          <h2 class="text-sm font-extrabold mb-2" style="color:#0f172a;">Description</h2>
          <p class="text-sm leading-relaxed" style="color:#334155;">
            {{ product.description|striptags }}
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>
{% endblock %}

